 000000BC			convertirDecimal proc
 000000BC  BB 0000000A		    mov ebx, 10        ; 10 sera el divisor
 000000C1  B9 00000000		    mov ecx, 0        ; contador de digitos

				    ;EXTRAER DÍGITOS
 000000C6			ExtraerDigitos:
 000000C6  BA 00000000		    mov edx, 0  ; se limpia edx para guardar el residuo de la division
 000000CB  F7 F3		    div ebx     ; se divide el digito de eax y el residuo se queda en edx
 000000CD  52			    push edx    ; se guarda el residuo en la pila
 000000CE  41			    inc ecx     ; incremento de ecx para ir al siguiente digito
 000000CF  83 F8 00		    cmp eax, 0      ; comparar si el cociente es diferente de cero
 000000D2  75 F2		    jne ExtraerDigitos

				    ;CONSTRUIR CADENA
 000000D4			ConstruirCadena:
 000000D4  5A			    pop edx     ; se saca el digito
 000000D5  80 C2 30		    add dl, '0'     ; se le suma el caracter '0'
 000000D8  88 16		    mov [esi], dl   ; se guarda el caracter 
 000000DA  46			    inc esi     ; siguiente posicion del buffer para el siguiente caracter
 000000DB  E2 F7		    loop ConstruirCadena    ; loop hasta que no queden digitos

 000000DD  B2 00		    mov dl, 0   ; terminador nulo
 000000DF  88 16		    mov [esi], dl   ; se le agrega el terminador nulo al final de la cadena
 000000E1  C3			    ret
 000000E2			convertirDecimal endp

